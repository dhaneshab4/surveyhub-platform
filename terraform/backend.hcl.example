# Remote state on Cloudflare R2, which speaks the S3 API and has a free tier.
#
#   cp backend.hcl.example backend.hcl     # backend.hcl is gitignored
#   terraform init -backend-config=backend.hcl
#
# Create the bucket first:
#   npx wrangler r2 bucket create surveyhub-tfstate
#
# Credentials come from the environment, never this file:
#   export AWS_ACCESS_KEY_ID=<R2 access key id>
#   export AWS_SECRET_ACCESS_KEY=<R2 secret access key>

bucket   = "surveyhub-tfstate"
endpoints = {
  s3 = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
}
